# Copy this file to .env and fill in your own values. Never commit .env.

# Option 1: institutional API (replace with your institution's endpoint)
API_URL=https://<your-institution-api>/v1/
API_KEY=your_key_here

# Option 2: OpenAI
# API_URL=https://api.openai.com/v1
# API_KEY=your_key_here
# OPENAI_ORG=org_...   # optional
